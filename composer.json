{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "cable8mm/prompt-weaver",
  "description": "Prompt Weaver is a simple library for creating and managing prompts in PHP.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/cable8mm/prompt-weaver",
  "require": {
    "php": "^8.3",
    "bacon/bacon-qr-code": "^3.1",
    "cable8mm/enum-getter": "^2.1",
    "ext-gd": "*"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "laravel/pint": "^1.0",
    "laravel/framework": "^13.22",
    "orchestra/testbench": "^11.1"
  },
  "suggest": {
    "ext-gd": "Required for generating QR codes."
  },
  "autoload": {
    "psr-4": {
      "Cable8mm\\PromptWeaver\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Cable8mm\\PromptWeaver\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Samgu Lee",
      "email": "cable8mm@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "./vendor/bin/pest",
    "lint": "./vendor/bin/pint",
    "inspect": "./vendor/bin/pint --test"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
