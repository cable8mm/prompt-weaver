{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cable8mm/prompt-weaver/blob/main/schemas/config.schema.json",
  "title": "Prompt Weaver exported config",
  "description": "Contract for the config.json generated by the export command.",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "canvas",
    "style",
    "content",
    "placeholders"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of the exported config contract."
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "canvas": {
      "type": "object",
      "required": ["width_pc", "height_pc", "aspect_ratio"],
      "properties": {
        "width_pc": { "$ref": "#/$defs/percentage" },
        "height_pc": { "$ref": "#/$defs/percentage" },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?:[0-9]+(?:\\.[0-9]+)?$"
        },
        "width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "height_mm": { "type": "number", "exclusiveMinimum": 0 },
        "dpi": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "required": ["theme", "background", "print_target"],
      "properties": {
        "theme": { "type": "string" },
        "background": { "type": "string" },
        "print_target": {
          "type": "string",
          "enum": [
            "black-and-white laser printer safe",
            "full-color inkjet printer",
            "RGB digital display"
          ]
        }
      },
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/contentElement" },
        "wifi_icon": { "$ref": "#/$defs/contentElement" },
        "message": { "$ref": "#/$defs/contentElement" },
        "footer": { "$ref": "#/$defs/contentElement" }
      },
      "additionalProperties": true
    },
    "placeholders": {
      "type": "object",
      "required": ["ssid", "password", "qr"],
      "properties": {
        "ssid": { "$ref": "#/$defs/placeholder" },
        "password": { "$ref": "#/$defs/placeholder" },
        "qr": { "$ref": "#/$defs/qrPlaceholder" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "placeholders": {
            "anyOf": [
              {
                "required": ["ssid"],
                "properties": { "ssid": { "required": ["font_size_pt"] } }
              },
              {
                "required": ["password"],
                "properties": { "password": { "required": ["font_size_pt"] } }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "canvas": { "required": ["width_mm", "height_mm", "dpi"] }
        }
      }
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "code",
        "category",
        "format",
        "color_mode",
        "name",
        "description",
        "color_direction",
        "font_mood"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "color_mode": { "type": "string", "enum": ["color", "mono"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "color_direction": { "type": "string", "minLength": 1 },
        "font_mood": { "type": "string", "minLength": 1 },
        "style": {
          "type": "object",
          "required": ["theme", "background"],
          "properties": {
            "theme": { "type": "string", "minLength": 1 },
            "background": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "contentElement": {
      "type": "object",
      "required": ["x_pc", "y_pc"],
      "properties": {
        "text": { "type": "string" },
        "x_pc": { "$ref": "#/$defs/percentage" },
        "y_pc": { "$ref": "#/$defs/percentage" },
        "align": { "type": "string" },
        "style": { "type": "string" }
      },
      "additionalProperties": true
    },
    "placeholder": {
      "type": "object",
      "required": ["box_x_pc", "box_y_pc", "box_width_pc", "box_height_pc"],
      "properties": {
        "box_x_pc": { "$ref": "#/$defs/percentage" },
        "box_y_pc": { "$ref": "#/$defs/percentage" },
        "box_width_pc": { "$ref": "#/$defs/percentage" },
        "box_height_pc": { "$ref": "#/$defs/percentage" },
        "font_size_pt": { "type": "number", "minimum": 6, "maximum": 96 },
        "font_size_px": { "type": "number", "exclusiveMinimum": 0 }
      },
      "anyOf": [{ "required": ["font_size_pt"] }, { "required": ["font_size_px"] }],
      "additionalProperties": true
    },
    "qrPlaceholder": {
      "type": "object",
      "required": ["x_pc", "y_pc", "width_pc"],
      "properties": {
        "x_pc": { "$ref": "#/$defs/percentage" },
        "y_pc": { "$ref": "#/$defs/percentage" },
        "width_pc": { "$ref": "#/$defs/percentage" }
      },
      "additionalProperties": true
    }
  }
}
