#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__).'/vendor/autoload.php';

use Cable8mm\PromptWeaver\ConfigPrompt;
use Cable8mm\PromptWeaver\DesignBriefPrompt;
use Cable8mm\PromptWeaver\ImagePrompt;

final class PromptWeaverCli
{
    private const DEFAULT_FIXTURES_ROOT = 'tests/Fixtures';

    private const DEFAULT_DIST_ROOT = 'dist';

    private const DEFAULT_PRODUCT = 'a Wi-Fi signage template';

    private const DEFAULT_CATEGORY = 'Cafe/Restaurant';

    private const DEFAULT_FORMAT = 'A4/A5 Poster';

    public function run(array $argv): int
    {
        array_shift($argv);

        $command = array_shift($argv) ?? 'help';

        try {
            return match ($command) {
                'dist' => $this->dist($argv),
                'init' => $this->init($argv),
                'brief' => $this->brief($argv),
                'config' => $this->config($argv),
                'image' => $this->image($argv),
                'chain' => $this->chain($argv),
                'help', '--help', '-h' => $this->help(),
                default => $this->error("Unknown command: {$command}"),
            };
        } catch (Throwable $throwable) {
            fwrite(STDERR, $throwable->getMessage().PHP_EOL);

            return 1;
        }
    }

    private function brief(array $argv): int
    {
        $options = $this->parseOptions($argv);

        $product = $options['product'] ?? null;
        $category = $options['category'] ?? null;
        $format = $options['format'] ?? null;

        $this->requireValues($product, $category, $format);

        $prompt = new DesignBriefPrompt($product);

        echo $prompt->build($category, $format).PHP_EOL;

        return 0;
    }

    private function init(array $argv): int
    {
        $options = $this->parseOptions($argv);

        $model = $options['model'] ?? null;
        $scenario = $options['scenario'] ?? null;
        $fixturesRoot = $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT;

        $this->requireValues($model, $scenario);

        $model = $this->validatePathSegment($model, 'model');
        $scenario = $this->validatePathSegment($scenario, 'scenario');
        $fixturesRoot = rtrim($fixturesRoot, '/');

        $manifestPath = "{$fixturesRoot}/{$model}/{$scenario}/manifest.json";

        if (is_file($manifestPath)) {
            throw new RuntimeException("Fixture already exists: {$manifestPath}");
        }

        $directory = dirname($manifestPath);

        if (! is_dir($directory) && ! mkdir($directory, 0777, true) && ! is_dir($directory)) {
            throw new RuntimeException("Unable to create directory: {$directory}");
        }

        $manifest = [
            'model' => $model,
            'scenario' => $scenario,
            'product' => self::DEFAULT_PRODUCT,
            'category' => self::DEFAULT_CATEGORY,
            'format' => self::DEFAULT_FORMAT,
        ];

        $json = json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR).PHP_EOL;

        if (file_put_contents($manifestPath, $json) === false) {
            throw new RuntimeException("Unable to write manifest: {$manifestPath}");
        }

        echo "Created {$manifestPath}".PHP_EOL;

        return 0;
    }

    private function dist(array $argv): int
    {
        $options = $this->parseOptions($argv);

        $fixturesRoot = $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT;
        $distRoot = $options['dist-root'] ?? self::DEFAULT_DIST_ROOT;

        if (! is_dir($fixturesRoot)) {
            throw new RuntimeException("Fixtures root not found: {$fixturesRoot}");
        }

        $copied = 0;
        $fixturesRoot = rtrim($fixturesRoot, '/');
        $distRoot = rtrim($distRoot, '/');

        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($fixturesRoot, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::SELF_FIRST
        );

        foreach ($iterator as $path => $info) {
            if (! $info->isFile() || ! in_array($info->getFilename(), ['config.json', 'image.txt'], true)) {
                continue;
            }

            $relativePath = substr($path, strlen($fixturesRoot) + 1);
            $targetPath = $distRoot.'/'.$relativePath;
            $targetDirectory = dirname($targetPath);

            if (! is_dir($targetDirectory) && ! mkdir($targetDirectory, 0777, true) && ! is_dir($targetDirectory)) {
                throw new RuntimeException("Unable to create directory: {$targetDirectory}");
            }

            if (! copy($path, $targetPath)) {
                throw new RuntimeException("Unable to copy {$path} to {$targetPath}");
            }

            $copied++;
        }

        echo "Copied {$copied} fixture file(s) from {$fixturesRoot} to {$distRoot}".PHP_EOL;

        return 0;
    }

    private function config(array $argv): int
    {
        $options = $this->parseOptions($argv);
        $designBrief = $options['brief'] ?? null;

        $this->requireValues($designBrief);

        echo (new ConfigPrompt())->build($designBrief).PHP_EOL;

        return 0;
    }

    private function image(array $argv): int
    {
        $options = $this->parseOptions($argv);
        $configPath = $options['config-file'] ?? null;

        $this->requireValues($configPath);

        if (! is_string($configPath) || ! is_file($configPath)) {
            throw new RuntimeException("Config file not found: {$configPath}");
        }

        $config = json_decode((string) file_get_contents($configPath), true, 512, JSON_THROW_ON_ERROR);

        echo (new ImagePrompt())->build($config).PHP_EOL;

        return 0;
    }

    private function chain(array $argv): int
    {
        $options = $this->parseOptions($argv);

        $product = $options['product'] ?? null;
        $category = $options['category'] ?? null;
        $format = $options['format'] ?? null;
        $brief = $options['brief'] ?? null;
        $configFile = $options['config-file'] ?? null;

        $this->requireValues($product, $category, $format, $brief, $configFile);

        if (! is_string($configFile) || ! is_file($configFile)) {
            throw new RuntimeException("Config file not found: {$configFile}");
        }

        $config = json_decode((string) file_get_contents($configFile), true, 512, JSON_THROW_ON_ERROR);

        $briefPrompt = (new DesignBriefPrompt($product))->build($category, $format);
        $configPrompt = (new ConfigPrompt())->build($brief);
        $imagePrompt = (new ImagePrompt())->build($config);

        echo "=== design-brief prompt ===".PHP_EOL;
        echo $briefPrompt.PHP_EOL;
        echo PHP_EOL;
        echo "=== config prompt ===".PHP_EOL;
        echo $configPrompt.PHP_EOL;
        echo PHP_EOL;
        echo "=== image prompt ===".PHP_EOL;
        echo $imagePrompt.PHP_EOL;

        return 0;
    }

    private function help(): int
    {
        echo <<<TEXT
Prompt Weaver CLI

Usage:
  bin/prompt-weaver dist [--fixtures-root=tests/Fixtures] [--dist-root=dist]
  bin/prompt-weaver init --model="..." --scenario="..." [--fixtures-root=tests/Fixtures]
  bin/prompt-weaver brief --product="..." --category="..." --format="..."
  bin/prompt-weaver config --brief="..."
  bin/prompt-weaver image --config-file=path/to/config.json
  bin/prompt-weaver chain --product="..." --category="..." --format="..." --brief="..." --config-file=path/to/config.json

TEXT;

        return 0;
    }

    private function error(string $message): int
    {
        fwrite(STDERR, $message.PHP_EOL);
        fwrite(STDERR, "Try: bin/prompt-weaver --help".PHP_EOL);

        return 1;
    }

    /**
     * @param  array<int, string>  $argv
     * @return array<string, string>
     */
    private function parseOptions(array $argv): array
    {
        $options = [];

        foreach ($argv as $argument) {
            if (! str_starts_with($argument, '--')) {
                continue;
            }

            $argument = substr($argument, 2);
            [$key, $value] = array_pad(explode('=', $argument, 2), 2, null);

            if ($key === '') {
                continue;
            }

            $options[$key] = $value ?? '1';
        }

        return $options;
    }

    private function requireValues(string ...$values): void
    {
        foreach ($values as $value) {
            if (! is_string($value) || $value === '') {
                throw new InvalidArgumentException('Missing required argument.');
            }
        }
    }

    private function validatePathSegment(string $value, string $name): string
    {
        if (! preg_match('/^[A-Za-z0-9._-]+$/', $value)) {
            throw new InvalidArgumentException("Invalid {$name}: {$value}");
        }

        return $value;
    }
}

exit((new PromptWeaverCli())->run($argv));
