{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "cable8mm/prompt-weaver",
  "description": "Prompt Weaver is a simple library for creating and managing prompts in PHP.",
  "type": "library",
  "homepage": "https://github.com/cable8mm/prompt-weaver",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "laravel/pint": "^1.0"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Cable8mm\\PromptWeaver\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cable8mm\\PromptWeaver\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Samgu Lee",
      "email": "cable8mm@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "./vendor/bin/pest",
    "lint": "./vendor/bin/pint",
    "inspect": "./vendor/bin/pint --test"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
