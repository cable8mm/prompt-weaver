#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__).'/vendor/autoload.php';

use Cable8mm\NanoAI\Client;
use Cable8mm\PromptWeaver\ConfigPrompt;
use Cable8mm\PromptWeaver\DesignBriefPrompt;
use Cable8mm\PromptWeaver\Enums\Category;
use Cable8mm\PromptWeaver\Enums\Format;
use Cable8mm\PromptWeaver\ImagePrompt;
use Cable8mm\PromptWeaver\Pipe;
use Cable8mm\PromptWeaver\Tools\PreviewImage;

use function Laravel\Prompts\info;
use function Laravel\Prompts\note;
use function Laravel\Prompts\select;
use function Laravel\Prompts\text;

final class PromptWeaverCli
{
    private const DEFAULT_FIXTURES_ROOT = 'tests/Fixtures';

    private const DEFAULT_PRODUCT = 'a Wi-Fi signage template';

    private const DEFAULT_CATEGORY = 'Cafe/Restaurant';

    private const DEFAULT_FORMAT = 'A4/A5 Poster';

    public function run(array $argv): int
    {
        array_shift($argv);

        $command = array_shift($argv) ?? 'help';

        try {
            return match ($command) {
                'init' => $this->init($argv),
                'calibrate' => $this->calibrate($argv),
                'preview' => $this->preview($argv),
                'brief' => $this->brief($argv),
                'config' => $this->config($argv),
                'image' => $this->image($argv),
                'chain' => $this->chain($argv),
                'pipe' => $this->pipe($argv),
                'help', '--help', '-h' => $this->help(),
                default => $this->error("Unknown command: {$command}"),
            };
        } catch (Throwable $throwable) {
            $this->displayError($throwable->getMessage());

            return 1;
        }
    }

    private function brief(array $argv): int
    {
        $options = $this->parseOptions($argv);

        if (($fixtureReference = $this->firstPositional($argv)) !== null) {
            $manifest = $this->readJsonFile($this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT).'/manifest.json');
            $product = $manifest['product'] ?? null;
            $category = $manifest['category'] ?? null;
            $format = $manifest['format'] ?? null;
        } else {
            $product = $options['product'] ?? null;
            $category = $options['category'] ?? null;
            $format = $options['format'] ?? null;
        }

        $this->requireValues($product, $category, $format);

        $designBriefPrompt = new DesignBriefPrompt(
            product: $product,
            category: Category::fromCliInput($category),
            format: Format::fromCliInput($format),
        );
        $designBriefPrompt->build();
        $promptText = $designBriefPrompt->prompt();

        if ($fixtureReference !== null) {
            $fixtureDirectory = $this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT);
            $promptPath = $fixtureDirectory.'/brief.prompt';

            if (file_put_contents($promptPath, $promptText.PHP_EOL) === false) {
                throw new RuntimeException("Unable to write prompt: {$promptPath}");
            }
        }

        echo $promptText.PHP_EOL;

        return 0;
    }

    private function init(array $argv): int
    {
        $options = $this->parseOptions($argv);

        $fixturesRoot = $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT;

        [$model, $scenario] = $this->resolveInitIdentifiers($argv, $options);

        $model = $this->validatePathSegment($model, 'model');
        $scenario = $this->validatePathSegment($scenario, 'scenario');
        $fixturesRoot = rtrim($fixturesRoot, '/');

        $manifestPath = "{$fixturesRoot}/{$model}/{$scenario}/manifest.json";

        if (is_file($manifestPath)) {
            throw new RuntimeException("Fixture already exists: {$manifestPath}");
        }

        $directory = dirname($manifestPath);

        if (! is_dir($directory) && ! mkdir($directory, 0777, true) && ! is_dir($directory)) {
            throw new RuntimeException("Unable to create directory: {$directory}");
        }

        $category = $options['category'] ?? $this->askChoice('category', Category::cliChoices(), self::DEFAULT_CATEGORY);
        $format = $options['format'] ?? $this->askChoice('format', Format::cliChoices(), self::DEFAULT_FORMAT);

        $manifest = [
            'model' => $model,
            'scenario' => $scenario,
            'product' => $options['product'] ?? self::DEFAULT_PRODUCT,
            'category' => $category,
            'format' => $format,
        ];

        $json = json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR).PHP_EOL;

        if (file_put_contents($manifestPath, $json) === false) {
            throw new RuntimeException("Unable to write manifest: {$manifestPath}");
        }

        info("Created {$manifestPath}");

        return 0;
    }

    private function preview(array $argv): int
    {
        $options = $this->parseOptions($argv);
        $fixtureDirectory = $this->resolveFixtureDirectory($argv);

        $outputOption = $options['output'] ?? null;
        $outputPath = $outputOption === 'html'
            ? rtrim($fixtureDirectory, '/').'/preview.html'
            : ($outputOption ?? rtrim($fixtureDirectory, '/').'/preview.png');

        $preview = new PreviewImage($fixtureDirectory);
        if (strtolower(pathinfo($outputPath, PATHINFO_EXTENSION)) === 'html') {
            $preview->renderHtml($outputPath, $options);
        } else {
            $preview->render($outputPath, $options);
        }

        info("Created {$outputPath}");

        return 0;
    }

    private function calibrate(array $argv): int
    {
        $fixtureDirectory = $this->resolveFixtureDirectory($argv);

        (new PreviewImage($fixtureDirectory))->calibrate();

        info('Updated '.rtrim($fixtureDirectory, '/').'/calibrate.config.json');

        return 0;
    }

    private function config(array $argv): int
    {
        $options = $this->parseOptions($argv);
        $fixtureReference = $this->firstPositional($argv);

        if ($fixtureReference === null) {
            $designBrief = $options['brief'] ?? null;
            $colorDirection = $options['color-direction'] ?? null;
            $fontMood = $options['font-mood'] ?? null;
            $conceptName = $options['concept-name'] ?? null;
        } else {
            $designBriefJson = $this->readJsonFile($this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT).'/design-brief.json');
            $designBrief = $designBriefJson['design_brief'] ?? null;
            $colorDirection = $designBriefJson['color_direction'] ?? null;
            $fontMood = $designBriefJson['font_mood'] ?? null;
            $conceptName = $designBriefJson['concept_name'] ?? null;
        }

        $this->requireValues($designBrief, $colorDirection, $fontMood);

        $configPrompt = new ConfigPrompt(
            designBrief: $designBrief,
            colorDirection: $colorDirection,
            fontMood: $fontMood,
            conceptName: $conceptName,
        );
        $configPrompt->build();
        $promptText = $configPrompt->prompt();

        if ($fixtureReference !== null) {
            $fixtureDirectory = $this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT);
            $promptPath = $fixtureDirectory.'/config.prompt';

            if (file_put_contents($promptPath, $promptText.PHP_EOL) === false) {
                throw new RuntimeException("Unable to write prompt: {$promptPath}");
            }
        }

        echo $promptText.PHP_EOL;

        return 0;
    }

    private function image(array $argv): int
    {
        $options = $this->parseOptions($argv);
        $fixtureReference = $this->firstPositional($argv);
        $configPath = $fixtureReference === null
            ? ($options['config-file'] ?? null)
            : $this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT).'/config.json';

        $this->requireValues($configPath);

        if (! is_string($configPath) || ! is_file($configPath)) {
            throw new RuntimeException("Config file not found: {$configPath}");
        }

        $config = $this->readJsonFile($configPath);

        $imagePrompt = new ImagePrompt($config);
        $imagePrompt->build();
        $promptText = $imagePrompt->prompt();

        if ($fixtureReference !== null) {
            $fixtureDirectory = $this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT);
            $promptPath = $fixtureDirectory.'/image.prompt';

            if (file_put_contents($promptPath, $promptText.PHP_EOL) === false) {
                throw new RuntimeException("Unable to write prompt: {$promptPath}");
            }
        }

        echo $promptText.PHP_EOL;

        return 0;
    }

    private function chain(array $argv): int
    {
        $options = $this->parseOptions($argv);

        $product = $options['product'] ?? null;
        $category = $options['category'] ?? null;
        $format = $options['format'] ?? null;
        $brief = $options['brief'] ?? null;
        $colorDirection = $options['color-direction'] ?? null;
        $fontMood = $options['font-mood'] ?? null;
        $conceptName = $options['concept-name'] ?? null;
        $configFile = $options['config-file'] ?? null;

        $this->requireValues($product, $category, $format, $brief, $colorDirection, $fontMood, $configFile);

        if (! is_string($configFile) || ! is_file($configFile)) {
            throw new RuntimeException("Config file not found: {$configFile}");
        }

        $config = $this->readJsonFile($configFile);

        $briefPrompt = new DesignBriefPrompt(
            product: $product,
            category: Category::fromCliInput($category),
            format: Format::fromCliInput($format),
        );
        $briefPrompt->build();
        $briefPromptText = $briefPrompt->prompt();

        $configPrompt = new ConfigPrompt(
            designBrief: $brief,
            colorDirection: $colorDirection,
            fontMood: $fontMood,
            conceptName: $conceptName,
        );
        $configPrompt->build();
        $configPromptText = $configPrompt->prompt();

        $imagePrompt = new ImagePrompt($config);
        $imagePrompt->build();
        $imagePromptText = $imagePrompt->prompt();

        $this->displaySection('design-brief prompt', $briefPromptText);
        $this->displaySection('config prompt', $configPromptText);
        $this->displaySection('image prompt', $imagePromptText);

        return 0;
    }

    private function pipe(array $argv): int
    {
        $options = $this->parseOptions($argv);

        $provider = $options['provider'] ?? 'openrouter';
        $apiKey = $options['api-key'] ?? null;
        $model = $options['model'] ?? 'google/gemma-4-26b-a4b-it:free';

        $client = new Client(
            provider: $provider,
            apiKey: $apiKey,
            model: $model,
        );

        if (($fixtureReference = $this->firstPositional($argv)) !== null) {
            $manifest = $this->readJsonFile($this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT).'/manifest.json');
            $product = $manifest['product'] ?? null;
            $category = $manifest['category'] ?? null;
            $format = $manifest['format'] ?? null;
        } else {
            $product = $options['product'] ?? null;
            $category = $options['category'] ?? null;
            $format = $options['format'] ?? null;
        }

        $this->requireValues($product, $category, $format);

        $color = $options['color'] ?? null;

        $result = (new Pipe($client))->run(
            $product,
            Category::fromCliInput($category),
            Format::fromCliInput($format),
            $color,
        );

        $this->displaySection('design-brief prompt', $result->briefPrompt);
        $this->displaySection('design-brief response', json_encode($result->briefJson, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
        $this->displaySection('config prompt', $result->configPrompt);
        $this->displaySection('config response', json_encode($result->config, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
        $this->displaySection('image prompt', $result->imagePrompt);

        return 0;
    }

    private function help(): int
    {
        note(<<<'TEXT'
Prompt Weaver CLI

Usage:
  bin/prompt-weaver init model/scenario [--product="..."] [--category="..."] [--format="..."] [--fixtures-root=tests/Fixtures]
  bin/prompt-weaver calibrate model/scenario [--fixtures-root=tests/Fixtures]
  bin/prompt-weaver preview --fixture="path/to/fixture"
  bin/prompt-weaver preview --fixture="path/to/fixture" --output="path/to/preview.html"
  bin/prompt-weaver preview --model="..." --scenario="..." [--fixtures-root=tests/Fixtures]
  bin/prompt-weaver brief model/scenario [--fixtures-root=tests/Fixtures]
  bin/prompt-weaver config model/scenario [--fixtures-root=tests/Fixtures]
  bin/prompt-weaver image model/scenario [--fixtures-root=tests/Fixtures]
  bin/prompt-weaver chain --product="..." --category="..." --format="..." --brief="..." --color-direction="..." --font-mood="..." [--concept-name="..."] --config-file=path/to/config.json
  bin/prompt-weaver pipe model/scenario [--provider=openrouter] [--api-key=sk-or-...] [--model=google/gemma-4-26b-a4b-it:free] [--color=...]
  bin/prompt-weaver pipe --product="..." --category="..." --format="..." [--provider=openrouter] [--api-key=sk-or-...] [--model=google/gemma-4-26b-a4b-it:free]

Available categories:
  Cafe/Restaurant, Office/Coworking, Stay/Hotel, Event/Exhibition, Other

Available formats:
  A4/A5 Poster, L-Stand/Table Tent, Sticker, Business Card

TEXT);

        return 0;
    }

    private function error(string $message): int
    {
        $this->displayError($message);
        $this->displayError('Try: bin/prompt-weaver --help');

        return 1;
    }

    /**
     * @param  array<int, string>  $argv
     * @return array<string, string>
     */
    private function parseOptions(array $argv): array
    {
        $options = [];

        foreach ($argv as $argument) {
            if (! str_starts_with($argument, '--')) {
                continue;
            }

            $argument = substr($argument, 2);
            [$key, $value] = array_pad(explode('=', $argument, 2), 2, null);

            if ($key === '') {
                continue;
            }

            $options[$key] = $value ?? '1';
        }

        return $options;
    }

    /** @param array<int, string> $argv */
    private function firstPositional(array $argv): ?string
    {
        foreach ($argv as $argument) {
            if (! str_starts_with($argument, '--')) {
                return $argument;
            }
        }

        return null;
    }

    /**
     * @param  array<int, string>  $argv
     * @param  array<string, string>  $options
     * @return array{0: string, 1: string}
     */
    private function resolveInitIdentifiers(array $argv, array $options): array
    {
        if (($fixtureReference = $this->firstPositional($argv)) !== null) {
            return $this->parseFixtureReference($fixtureReference);
        }

        $model = $options['model'] ?? $this->askText('model', 'chatgpt');
        $scenario = $options['scenario'] ?? $this->askText('scenario', 'cafe-restaurant');

        if ($model === '' || $scenario === '') {
            throw new InvalidArgumentException('Missing required argument: model/scenario (e.g. init chatgpt/cafe-restaurant)');
        }

        return [$model, $scenario];
    }

    private function resolveFixtureDirectory(array $argv): string
    {
        $options = $this->parseOptions($argv);
        $fixtureDirectory = isset($options['fixture']) ? $options['fixture'] : null;

        if (($fixtureReference = $this->firstPositional($argv)) !== null) {
            $fixtureDirectory = $this->fixtureDirectory($fixtureReference, $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT);
        }

        if (! is_string($fixtureDirectory) || $fixtureDirectory === '') {
            $fixturesRoot = $options['fixtures-root'] ?? self::DEFAULT_FIXTURES_ROOT;
            $model = $options['model'] ?? null;
            $scenario = $options['scenario'] ?? null;

            $this->requireValues($model, $scenario);

            $fixtureDirectory = rtrim($fixturesRoot, '/').'/'.$this->validatePathSegment($model, 'model').'/'.$this->validatePathSegment($scenario, 'scenario');
        }

        if (! is_dir($fixtureDirectory)) {
            throw new RuntimeException("Fixture directory not found: {$fixtureDirectory}");
        }

        return $fixtureDirectory;
    }

    /** @return array{0: string, 1: string} */
    private function parseFixtureReference(string $reference): array
    {
        $parts = explode('/', trim($reference, '/'));

        if (count($parts) !== 2 || in_array('', $parts, true)) {
            throw new InvalidArgumentException("Fixture must be in the form model/scenario: {$reference}");
        }

        return [
            $this->validatePathSegment($parts[0], 'model'),
            $this->validatePathSegment($parts[1], 'scenario'),
        ];
    }

    private function fixtureDirectory(string $reference, string $fixturesRoot): string
    {
        [$model, $scenario] = $this->parseFixtureReference($reference);

        return rtrim($fixturesRoot, '/').'/'.$model.'/'.$scenario;
    }

    /** @return array<string, mixed> */
    private function readJsonFile(string $path): array
    {
        if (! is_file($path)) {
            throw new RuntimeException("JSON file not found: {$path}");
        }

        $json = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);

        if (! is_array($json)) {
            throw new RuntimeException("JSON object expected: {$path}");
        }

        return $json;
    }

    private function requireValues(string ...$values): void
    {
        foreach ($values as $value) {
            if (! is_string($value) || $value === '') {
                throw new InvalidArgumentException('Missing required argument.');
            }
        }
    }

    private function validatePathSegment(string $value, string $name): string
    {
        if (! preg_match('/^[A-Za-z0-9._-]+$/', $value)) {
            throw new InvalidArgumentException("Invalid {$name}: {$value}");
        }

        return $value;
    }

    /**
     * Prompt the user to enter free text when running interactively.
     * Returns an empty string when STDIN is not a TTY (e.g. tests, CI, pipes).
     */
    private function askText(string $label, string $example): string
    {
        if (! stream_isatty(STDIN)) {
            return '';
        }

        return text("Enter {$label}", placeholder: $example);
    }

    /**
     * Prompt the user to select from a list of choices when running interactively.
     * Falls back to the default value when STDIN is not a TTY (e.g. tests, CI, pipes).
     *
     * @param  array<int, string>  $choices
     */
    private function askChoice(string $label, array $choices, string $default): string
    {
        if (! stream_isatty(STDIN)) {
            return $default;
        }

        $defaultIndex = array_search($default, $choices, true);
        $selection = select(
            label: "Select a {$label}",
            options: $choices,
            default: $defaultIndex === false ? null : $defaultIndex,
        );

        return $choices[(int) $selection] ?? $default;
    }

    private function displaySection(string $title, ?string $content): void
    {
        echo "=== {$title} ===".PHP_EOL;
        echo ($content ?? '').PHP_EOL.PHP_EOL;
    }

    private function displayError(string $message): void
    {
        if (stream_isatty(STDERR)) {
            note($message, 'error');

            return;
        }

        fwrite(STDERR, $message.PHP_EOL);
    }
}

exit((new PromptWeaverCli)->run($argv));
