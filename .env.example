# Copy this file to .env and add your local credentials.
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-svcacct-...
GEMINI_API_KEY=...
# Prompt Weaver defaults. CLI options override these values.
PROMPT_WEAVER_PROVIDER=openrouter
PROMPT_WEAVER_MODEL=google/gemma-4-26b-a4b-it:free
PROMPT_WEAVER_IMAGE_PROVIDER=gemini
PROMPT_WEAVER_IMAGE_MODEL=gemini-3.1-flash-lite-image
